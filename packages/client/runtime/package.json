{
  "name": "@coco-harness/cch-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cch": {
    "client": {
      "inject": [
        "@coco-harness/cch-client-connection",
        "@coco-harness/cch-typert-registry",
        "@coco-harness/cch-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-attachment": "workspace:^",
    "@coco-harness/cch-client-connection": "workspace:^",
    "@coco-harness/cch-client-ui-slots": "workspace:^",
    "@coco-harness/cch-commands": "workspace:^",
    "@coco-harness/cch-host-apiproxy": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-llm-retry": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-session-projection": "workspace:^",
    "@coco-harness/cch-session-title": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "immer": "^11.1.17",
    "react": "^19.2.8",
    "zustand": "~5.0.15"
  },
  "peerDependencies": {
    "@coco-harness/cch-api-remotes": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-typert-protocol": "workspace:^",
    "@coco-harness/cch-typert-registry": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coco-harness/cch-api-remotes": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-timeout": "workspace:^",
    "@coco-harness/cch-typert-protocol": "workspace:^",
    "@coco-harness/cch-typert-registry": "workspace:^",
    "@coco-harness/cordis": "workspace:^",
    "@types/react": "~19.2.18"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
