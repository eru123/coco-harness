{
  "name": "@coco-harness/cch-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cch": {
    "client": {
      "inject": [
        "@coco-harness/cch-client-runtime",
        "@coco-harness/cch-client-ui-settings",
        "@coco-harness/cch-client-locale",
        "@coco-harness/cch-client-connection",
        "@coco-harness/cch-api-remotes",
        "@coco-harness/cch-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/schemastery": "link:..\\..\\..\\vendor\\schemastery",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@coco-harness/cch-api-remotes": "workspace:^",
    "@coco-harness/cch-client-connection": "workspace:^",
    "@coco-harness/cch-client-locale": "workspace:^",
    "@coco-harness/cch-client-runtime": "workspace:^",
    "@coco-harness/cch-client-ui-primitives": "workspace:^",
    "@coco-harness/cch-client-ui-settings": "workspace:^",
    "@coco-harness/cch-client-ui-sidebar": "workspace:^",
    "@coco-harness/cch-client-ui-slots": "workspace:^",
    "@coco-harness/cch-client-web-react": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@coco-harness/cch-api-remotes": "workspace:^",
    "@coco-harness/cch-client-connection": "workspace:^",
    "@coco-harness/cch-client-locale": "workspace:^",
    "@coco-harness/cch-client-runtime": "workspace:^",
    "@coco-harness/cch-client-test-runtime": "workspace:^",
    "@coco-harness/cch-client-ui-primitives": "workspace:^",
    "@coco-harness/cch-client-ui-settings": "workspace:^",
    "@coco-harness/cch-client-ui-sidebar": "workspace:^",
    "@coco-harness/cch-client-ui-slots": "workspace:^",
    "@coco-harness/cch-client-web-react": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cordis": "workspace:^",
    "@types/react": "~19.2.18",
    "react": "^19.2.8"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
