{
  "name": "@coco-harness/cch-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Coco Harness filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@coco-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@coco-harness/cch-attachment": "workspace:^",
    "@coco-harness/cch-fs": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-sandbox": "workspace:^",
    "@coco-harness/cch-sandbox-policy": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-system-prompt": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "@coco-harness/cch-user-approval": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-agent-loop": "workspace:^",
    "@coco-harness/cch-agent-loop-testkit": "workspace:^",
    "@coco-harness/cch-attachment": "workspace:^",
    "@coco-harness/cch-fs": "workspace:^",
    "@coco-harness/cch-fs-local": "workspace:^",
    "@coco-harness/cch-fs-observation-policy": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-llm-deepseek": "workspace:^",
    "@coco-harness/cch-sandbox": "workspace:^",
    "@coco-harness/cch-sandbox-policy": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-system-prompt": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "@coco-harness/cch-user-approval": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  }
}
