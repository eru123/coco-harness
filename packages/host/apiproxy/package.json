{
  "name": "@coco-harness/cch-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-agent-default-model": "workspace:^",
    "@coco-harness/cch-api-remotes": "workspace:^",
    "@coco-harness/cch-attachment": "workspace:^",
    "@coco-harness/cch-brand": "workspace:^",
    "@coco-harness/cch-commands": "workspace:^",
    "@coco-harness/cch-credentials": "workspace:^",
    "@coco-harness/cch-goal": "workspace:^",
    "@coco-harness/cch-host-directory-picker": "workspace:^",
    "@coco-harness/cch-jobs": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-native-command": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-session-persistence": "workspace:^",
    "@coco-harness/cch-session-projection": "workspace:^",
    "@coco-harness/cch-session-projection-cache": "workspace:^",
    "@coco-harness/cch-session-query": "workspace:^",
    "@coco-harness/cch-session-title": "workspace:^",
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/cch-skill": "workspace:^",
    "@coco-harness/cch-subagent": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "@coco-harness/cch-user-approval": "workspace:^",
    "@coco-harness/cch-user-questions": "workspace:^",
    "@coco-harness/cch-workspace": "workspace:^",
    "@coco-harness/schemastery": "link:..\\..\\..\\vendor\\schemastery",
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@coco-harness/cch-agent-presets": "workspace:^",
    "@coco-harness/cch-cordis-host-runner": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coco-harness/cch-agent-presets": "workspace:^",
    "@coco-harness/cch-cordis-host-runner": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-storage": "workspace:^",
    "@coco-harness/cch-storage-domain": "workspace:^",
    "@coco-harness/cch-typert-protocol": "workspace:^",
    "@coco-harness/cch-typert-registry": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  }
}
