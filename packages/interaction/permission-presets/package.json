{
  "name": "@coco-harness/cch-permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the Coco Harness: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coco-harness/cch-commands": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-sandbox": "workspace:^",
    "@coco-harness/cch-sandbox-policy": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-session-projection": "workspace:^",
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/cch-shell": "workspace:^",
    "@coco-harness/cch-user-approval": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@coco-harness/schemastery": "link:..\\..\\..\\vendor\\schemastery",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@coco-harness/cch-commands": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-sandbox": "workspace:^",
    "@coco-harness/cch-sandbox-policy": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-session-projection": "workspace:^",
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/cch-shell": "workspace:^",
    "@coco-harness/cch-user-approval": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  }
}
