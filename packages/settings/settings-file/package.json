{
  "name": "@coco-harness/cch-settings-file",
  "description": "File-backed settings provider (settings.yaml) for the Coco Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/settings/settings-file"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coco-harness/cch-atomic-write": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-home-paths": "workspace:^",
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@coco-harness/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@coco-harness/cch-atomic-write": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-home-paths": "workspace:^",
    "@coco-harness/cch-settings": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  }
}
