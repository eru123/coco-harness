{
  "name": "@coco-harness/cch-subagent-acp",
  "description": "Out-of-process ACP subagent backend: drives a child agent in a spawned subprocess over the Agent Client Protocol",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-subagent": "workspace:^",
    "@coco-harness/cch-subprocess": "workspace:^",
    "@coco-harness/cch-timeout": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@coco-harness/schemastery": "link:..\\..\\..\\vendor\\schemastery"
  },
  "devDependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-loader-smoke": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-subagent": "workspace:^",
    "@coco-harness/cch-subprocess": "workspace:^",
    "@coco-harness/cch-subprocess-local": "workspace:^",
    "@coco-harness/cch-timeout": "workspace:^",
    "@coco-harness/cordis": "workspace:^",
    "@coco-harness/cordis-plugin-loader": "workspace:^"
  }
}
