{
  "name": "@coco-harness/cch-launch-environment",
  "description": "Immutable Coco Harness launch environment that records which layer supplied each value",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/util/launch-environment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  }
}
