{
  "name": "@coco-harness/cch-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Coco Harness web capability seam (ctx.web)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eru123/coco-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-system-prompt": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "@coco-harness/cch-web": "workspace:^",
    "@coco-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@coco-harness/schemastery": "link:..\\..\\..\\vendor\\schemastery",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@coco-harness/cch-agent": "workspace:^",
    "@coco-harness/cch-invariants": "workspace:^",
    "@coco-harness/cch-llm": "workspace:^",
    "@coco-harness/cch-session": "workspace:^",
    "@coco-harness/cch-spill-local": "workspace:^",
    "@coco-harness/cch-spill-policy": "workspace:^",
    "@coco-harness/cch-system-prompt": "workspace:^",
    "@coco-harness/cch-tool-call-timeout-policy": "workspace:^",
    "@coco-harness/cch-tools": "workspace:^",
    "@coco-harness/cch-web": "workspace:^",
    "@coco-harness/cch-web-fetch-http": "workspace:^",
    "@coco-harness/cch-web-search-exa": "workspace:^",
    "@coco-harness/cordis": "workspace:^",
    "@types/turndown": "^5.0.6"
  }
}
